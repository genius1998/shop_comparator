# Shop accounts for the web login tab's [.env 계정으로 로그인] button (optional).
# Never commit the real .env file.
MUSINSA_ID=
MUSINSA_PASSWORD=
KREAM_ID=
KREAM_PASSWORD=
POIZON_ID=
POIZON_PASSWORD=

# Web app options.
# SHOP_MUSINSA_HEADLESS=0   # show the Musinsa Chrome window
# SHOP_DEBUG_HTTP=1         # dump Musinsa requests/responses to stdout

# Optional KREAM Bearer token used by the KREAM search client and scripts/kream_search.py.
KREAM_BEARER=

# Optional Playwright browser overrides for packaged or custom browser setups.
PLAYWRIGHT_BROWSERS_PATH=
PLAYWRIGHT_BROWSER_EXECUTABLE=

# Optional OpenAI product matching verifier.
# Disabled by default; set OPENAI_MATCHING_ENABLED=1 to use it.
OPENAI_API_KEY=
OPENAI_MATCHING_ENABLED=0
OPENAI_MATCH_MODEL=gpt-5.4-nano
OPENAI_MATCH_MAX_CANDIDATES=5
OPENAI_MATCH_MAX_OUTPUT_TOKENS=500
OPENAI_MATCH_USE_IMAGES=1
OPENAI_EMBEDDING_MATCHING_ENABLED=0
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=256
OPENAI_EMBEDDING_MAX_CANDIDATES=8
OPENAI_EMBEDDING_ACCEPT_THRESHOLD=0.88
OPENAI_EMBEDDING_MARGIN_THRESHOLD=0.04

# Existing cache policy. Leave disabled when cleaning up historical mismatches.
KREAM_TRUST_EXISTING_MATCHES=0
KREAM_REVALIDATE_EXISTING_MATCHES=0

# Image check of product matches (python -m shop_comparator.matching.vlm_match).
# OpenAI backend (paid):
OPENAI_API_KEY_VLM=
OPENAI_VLM_MODEL=gpt-5.4-mini
# Local backend (--local, served by Ollama on this PC):
OLLAMA_VLM_MODEL=qwen3-vl:8b-instruct-q4_K_M
# OLLAMA_HOST=http://127.0.0.1:11434
# Benchmark of a self-hosted vision model (python -m shop_comparator.matching.vlm_benchmark run remote).
# A program that takes --image-a PATH --image-b PATH and prints JSON with result/confidence.
VLM_REMOTE_COMMAND=
VLM_REMOTE_MODEL=
